# Copy to .env.local (never committed) and fill in. All of these are optional:
# DooFah runs on Open-Meteo without any.

# Road routes (see "Route weather" in the README)
# CONTACT_EMAIL=
# OSRM_URL=

# AI voice (see "Spoken weather summary")
# GOOGLE_CLOUD_TTS_API_KEY=

# Open-Meteo commercial key (see "Weather data")
# OPEN_METEO_API_KEY=

# WeatherNext 3 nowcast for the owner (see "WeatherNext 3 nowcast (owner only)")
# GCP_PROJECT_ID=doofah-weather
# GCP_SERVICE_ACCOUNT_KEY='{"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...","client_email":"...@....iam.gserviceaccount.com"}'
# GCP_WEATHERNEXT_DATASET=weathernext
# WEATHERNEXT_OWNER_TOKEN=
# WEATHERNEXT_MAX_GB=25
# WEATHERNEXT_RAIN_VARIABLE=total_precipitation_1hr
# GCP_BIGQUERY_LOCATION=
